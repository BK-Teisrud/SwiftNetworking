# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Swift Package Manager: library lockfiles and generated package workspace
/.build/
/Packages/
/Package.resolved
/.swiftpm/xcode/
/.swiftpm/security/
/.swiftpm/configuration/registries.json

# Xcode user state and build products; preserve shared projects and schemes
xcuserdata/
*.xcuserstate
DerivedData/
*.xcarchive/
*.xcresult/
*.ipa
*.dSYM/
*.dSYM.zip

# Generated documentation (source .docc catalogs and Guides are committed)
*.doccarchive/
/documentation-output/

# Local credentials; example configuration may be committed
.env
.env.*
!.env.example
!.env.sample
.netrc
*.p12
*.p8
*.key
*.mobileprovision
/secrets/
/credentials/

# Editors and local tooling
.idea/
.vscode/
*.swp
*.swo
*~
__pycache__/
*.py[cod]
/.cache/
/tmp/
